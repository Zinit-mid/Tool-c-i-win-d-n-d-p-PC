<UserControl x:Class="PCTool.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Sao lưu trước khi cài lại Windows" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Sao lưu driver và Wi-Fi ra một thư mục (nên là ổ khác ổ C hoặc USB), và xem ổ nào đang bật BitLocker. Mỗi lần sao lưu tạo một thư mục mới theo ngày giờ, không ghi đè bản cũ." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Chọn thư mục..." Width="120" Height="30"
                    Margin="8,0,0,0" Click="BrowseButton_Click" />
            <TextBox x:Name="FolderBox" Height="30" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBox x:Name="ResultBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="8" />

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" Text="Sẵn sàng." />
        </StackPanel>

        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="DriverButton" Content="Sao lưu Driver" Width="130" Height="32" Margin="0,0,10,6"
                    Click="DriverButton_Click" />
            <Button x:Name="WifiButton" Content="Sao lưu Wi-Fi" Width="130" Height="32" Margin="0,0,10,6"
                    Click="WifiButton_Click" />
            <Button x:Name="ZaloButton" Content="Sao lưu Zalo" Width="130" Height="32" Margin="0,0,10,6"
                    Click="ZaloButton_Click" />
            <Button x:Name="BitLockerButton" Content="Xem BitLocker" Width="130" Height="32" Margin="0,0,10,6"
                    Click="BitLockerButton_Click" />
            <Button x:Name="CancelButton" Content="Dừng" Width="80" Height="32" Margin="0,0,10,6"
                    Click="CancelButton_Click" IsEnabled="False" />
            <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi máy)" IsChecked="True"
                      VerticalAlignment="Center" Margin="10,0,0,6" />
        </WrapPanel>
    </Grid>
</UserControl>
