<UserControl x:Class="PCTool.Views.AppInstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Cài nhanh ứng dụng" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Tick các ứng dụng cần cài rồi bấm Cài. App dùng winget để cài im lặng. Bạn có thể tự thêm ứng dụng khác và mang danh sách sang máy khác bằng Xuất/Nhập." />
        </StackPanel>

        <TextBlock x:Name="WarningText" Grid.Row="1" Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="Collapsed" />

        <DataGrid x:Name="AppsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Cài" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="Ứng dụng" Binding="{Binding Name}" IsReadOnly="True" Width="200" />
                <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" IsReadOnly="True" Width="120" />
                <DataGridTextColumn Header="Cách cài" Binding="{Binding KindText}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" Text="Sẵn sàng." TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="InstallButton" Content="Cài các mục đã chọn" Width="170" Height="40" Margin="0,0,10,6"
                    Click="InstallButton_Click" />
            <Button x:Name="CancelButton" Content="Dừng" Width="80" Height="40" Margin="0,0,10,6"
                    Click="CancelButton_Click" IsEnabled="False" />
            <Button x:Name="AddButton" Content="Thêm ứng dụng..." Width="140" Height="40" Margin="0,0,10,6"
                    Click="AddButton_Click" />
            <Button x:Name="RemoveButton" Content="Xóa / ẩn mục" Width="110" Height="40" Margin="0,0,10,6"
                    Click="RemoveButton_Click" />
            <Button x:Name="ExportButton" Content="Xuất danh sách" Width="120" Height="40" Margin="0,0,10,6"
                    Click="ExportButton_Click" />
            <Button x:Name="ImportButton" Content="Nhập danh sách" Width="120" Height="40" Margin="0,0,10,6"
                    Click="ImportButton_Click" />
            <Button x:Name="SuggestButton" Content="Thêm app gợi ý" Width="130" Height="40" Margin="0,0,10,6"
                    Click="SuggestButton_Click" />
            <Button x:Name="RestoreButton" Content="Hiện lại mục mặc định" Width="160" Height="40" Margin="0,0,10,6"
                    Click="RestoreButton_Click" />
            <CheckBox x:Name="DryRunBox" Content="Chạy thử (không cài thật)" IsChecked="True"
                      VerticalAlignment="Center" Margin="10,0,0,6" />
        </WrapPanel>
    </Grid>
</UserControl>
