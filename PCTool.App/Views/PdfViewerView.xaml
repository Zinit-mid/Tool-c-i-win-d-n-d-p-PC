<UserControl x:Class="PCTool.Views.PdfViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Xem PDF" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Xem nhanh file PDF ngay trong PCTool và xuất trang ra ảnh PNG (lưu vào thư mục mới cạnh file PDF, không sửa file gốc). Không mở được PDF có mật khẩu." />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Mở PDF..." Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Open_Click" />
                <TextBox x:Name="PathBox" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="PrevButton" Content="◀ Trang trước" Margin="0,0,8,4" IsEnabled="False" Click="Prev_Click" />
                <TextBlock x:Name="PageText" Text="–" VerticalAlignment="Center" Margin="4,0,12,4" MinWidth="70" TextAlignment="Center" />
                <Button x:Name="NextButton" Content="Trang sau ▶" Margin="0,0,16,4" IsEnabled="False" Click="Next_Click" />
                <Button x:Name="SaveOneButton" Content="Lưu trang này ra ảnh" Margin="0,0,8,4" IsEnabled="False" Click="SaveOne_Click" />
                <Button x:Name="SaveAllButton" Content="Lưu tất cả trang ra ảnh" Margin="0,0,8,4" IsEnabled="False" Click="SaveAll_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap" Text="Chưa mở file nào." />
        </StackPanel>
        <Border Background="#FFE9ECF1" CornerRadius="6" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PageImage" Stretch="Uniform" HorizontalAlignment="Center" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
