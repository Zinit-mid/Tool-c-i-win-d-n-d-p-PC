<UserControl x:Class="PCTool.Views.DefenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <TextBlock Text="Windows Defender" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Foreground="Gray" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="Tắt tạm Defender để cài phần mềm bị chặn nhầm. App luôn hẹn giờ để Windows tự bật lại, kể cả khi bạn tắt app hoặc khởi động lại máy." />

        <GroupBox Header="Trạng thái hiện tại" Padding="10">
            <StackPanel>
                <TextBlock x:Name="StateText" FontSize="16" FontWeight="SemiBold" Text="Chưa kiểm tra." />
                <TextBlock x:Name="DetailText" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="CountdownText" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Tắt trong:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MinutesBox" Width="110" Height="32" SelectedIndex="0" Margin="0,0,16,0">
                <ComboBoxItem Content="15 phút" Tag="15" />
                <ComboBoxItem Content="30 phút" Tag="30" />
                <ComboBoxItem Content="60 phút" Tag="60" />
            </ComboBox>
            <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi máy)" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>

        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Content="Kiểm tra trạng thái" Width="160" Height="40" Margin="0,0,10,6"
                    Click="RefreshButton_Click" />
            <Button x:Name="DisableButton" Content="Tắt tạm Defender" Width="150" Height="40" Margin="0,0,10,6"
                    Click="DisableButton_Click" />
            <Button x:Name="EnableButton" Content="Bật lại ngay" Width="120" Height="40" Margin="0,0,10,6"
                    Click="EnableButton_Click" />
        </WrapPanel>

        <TextBlock x:Name="ResultText" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
