<UserControl x:Class="PCTool.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Sao lưu dữ liệu cá nhân và danh sách app" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Chuẩn bị trước khi cài lại Windows. App chỉ SAO CHÉP (không xóa, không di chuyển file gốc) vào một thư mục mới theo ngày giờ. Nơi lưu phải nằm trên ổ vật lý KHÁC ổ Windows (ổ cứng riêng, USB, ổ cứng ngoài), nếu cùng ổ app từ chối. Mỗi lần lưu tạo thư mục mới, không ghi đè bản cũ." />

            <DockPanel Margin="0,0,0,10">
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Chọn nơi lưu..." Width="120" Height="30" Margin="8,0,0,0" Click="BrowseButton_Click" />
                <TextBox x:Name="DestBox" Height="30" VerticalContentAlignment="Center" />
            </DockPanel>

            <GroupBox Header="1. Dữ liệu cá nhân (tài khoản Windows đang dùng)" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="DesktopBox" Content="Desktop" IsChecked="True" Margin="0,0,16,4" />
                        <CheckBox x:Name="DocumentsBox" Content="Documents" IsChecked="True" Margin="0,0,16,4" />
                        <CheckBox x:Name="PicturesBox" Content="Pictures" IsChecked="True" Margin="0,0,16,4" />
                        <CheckBox x:Name="DownloadsBox" Content="Downloads" IsChecked="True" Margin="0,0,16,4" />
                        <CheckBox x:Name="VideosBox" Content="Videos" Margin="0,0,16,4" />
                        <CheckBox x:Name="MusicBox" Content="Music" Margin="0,0,16,4" />
                    </WrapPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6"
                               Text="Bấm Tính dung lượng trước để xem sẽ chép bao nhiêu và nơi lưu có đủ chỗ không (chỉ đọc, không chép gì). Thư mục có file chỉ nằm trên OneDrive sẽ bị bỏ qua để không tải về hàng loạt." />
                    <WrapPanel>
                        <Button x:Name="ScanButton" Content="Tính dung lượng" Width="140" Height="34" Margin="0,0,10,0" Click="ScanButton_Click" />
                        <Button x:Name="DataButton" Content="Sao lưu dữ liệu" Width="140" Height="34" Margin="0,0,10,0" Click="DataButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Danh sách app đã cài" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Lưu danh sách app đang cài và những app cài lại tự động được bằng winget vào file restore-plan.json (chỉ đọc máy, không cài hay gỡ gì). App không có trong winget thì bạn cài tay theo danh sách." />
                    <Button x:Name="AppsButton" Content="Lưu danh sách app" Width="160" Height="34" HorizontalAlignment="Left" Click="AppsButton_Click" />
                </StackPanel>
            </GroupBox>

            <CheckBox x:Name="DryRunBox" Content="Chạy thử (không chép/ghi gì)" IsChecked="True" Margin="0,0,0,8" />

            <GroupBox Header="Kết quả" Height="240">
                <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="13" />
            </GroupBox>
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
