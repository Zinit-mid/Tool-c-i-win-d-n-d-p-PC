<UserControl x:Class="PCTool.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Khôi phục sau khi cài Windows" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Dùng SAU khi cài xong Windows: mở PCTool từ ổ chứa bản sao lưu. Mỗi bước độc lập, làm bước nào tùy bạn; lỗi một bước không ảnh hưởng bước khác. Mặc định là Chạy thử. Chưa thử trên máy thật: nên làm từng bước và kiểm tra kết quả." />

            <GroupBox Header="1. Driver" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Chọn..." Width="80" Height="28" Margin="8,0,0,0" Tag="Driver" Click="Browse_Click" />
                        <TextBox x:Name="DriverBox" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" Text="Thư mục driver đã sao lưu (tab Sao lưu Driver / Wi-Fi)." />
                    <Button x:Name="DriverButton" Content="Cài lại driver" Width="140" Height="32" HorizontalAlignment="Left" Click="DriverButton_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Wi-Fi" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Chọn..." Width="80" Height="28" Margin="8,0,0,0" Tag="Wifi" Click="Browse_Click" />
                        <TextBox x:Name="WifiBox" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <Button x:Name="WifiButton" Content="Nạp lại Wi-Fi" Width="140" Height="32" HorizontalAlignment="Left" Click="WifiButton_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="3. Ứng dụng (winget)" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Chọn file..." Width="90" Height="28" Margin="8,0,0,0" Tag="Plan" Click="Browse_Click" />
                        <TextBox x:Name="PlanBox" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" Text="File restore-plan.json (trong thư mục apps của bản sao lưu). App không có trong winget thì bạn cài tay theo danh sách." />
                    <WrapPanel>
                        <Button x:Name="PlanReadButton" Content="Đọc danh sách" Width="140" Height="32" Margin="0,0,10,0" Click="PlanReadButton_Click" />
                        <Button x:Name="AppsButton" Content="Cài các app" Width="140" Height="32" Click="AppsButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="4. Dữ liệu cá nhân" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Chọn..." Width="80" Height="28" Margin="8,0,0,0" Tag="Data" Click="Browse_Click" />
                        <TextBox x:Name="DataBox" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" Text="Thư mục theo ngày giờ của bản sao lưu (bên trong có thư mục userdata). File đã có trên máy KHÔNG bị ghi đè." />
                    <WrapPanel Margin="0,0,0,6">
                        <CheckBox x:Name="DesktopBox" Content="Desktop" IsChecked="True" Margin="0,0,16,0" />
                        <CheckBox x:Name="DocumentsBox" Content="Documents" IsChecked="True" Margin="0,0,16,0" />
                        <CheckBox x:Name="PicturesBox" Content="Pictures" IsChecked="True" Margin="0,0,16,0" />
                        <CheckBox x:Name="DownloadsBox" Content="Downloads" IsChecked="True" Margin="0,0,16,0" />
                        <CheckBox x:Name="VideosBox" Content="Videos" Margin="0,0,16,0" />
                        <CheckBox x:Name="MusicBox" Content="Music" Margin="0,0,16,0" />
                    </WrapPanel>
                    <Button x:Name="DataButton" Content="Khôi phục dữ liệu" Width="160" Height="32" HorizontalAlignment="Left" Click="DataButton_Click" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="5. Zalo" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Chọn..." Width="80" Height="28" Margin="8,0,0,0" Tag="Zalo" Click="Browse_Click" />
                        <TextBox x:Name="ZaloBox" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" Text="Chọn thư mục Zalo trong bản sao lưu. Cài Zalo, đăng nhập một lần, rồi đóng hẳn Zalo trước. File đã có trên máy KHÔNG bị ghi đè. Chưa thử trên máy thật." />
                    <Button x:Name="ZaloButton" Content="Khôi phục Zalo" Width="160" Height="32" HorizontalAlignment="Left" Click="ZaloButton_Click" />
                </StackPanel>
            </GroupBox>

            <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi gì)" IsChecked="True" Margin="0,0,0,8" />
            <GroupBox Header="Kết quả" Height="220">
                <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="13" />
            </GroupBox>
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
