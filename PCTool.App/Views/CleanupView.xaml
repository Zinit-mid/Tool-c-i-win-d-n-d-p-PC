<UserControl x:Class="PCTool.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Dọn dẹp rác" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Bấm Quét để xem dung lượng từng mục, tick mục cần dọn rồi bấm Dọn. Chỉ xóa file tạm/cache, không đụng dữ liệu cá nhân." />
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Dọn" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                <DataGridTextColumn Header="Mục" Binding="{Binding Name}" IsReadOnly="True" Width="220" />
                <DataGridTextColumn Header="Chi tiết" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Số file" Binding="{Binding FileCount}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="Dung lượng" Binding="{Binding SizeText}" IsReadOnly="True" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <CheckBox x:Name="DryRunBox" IsChecked="True"
                      Content="Chế độ chạy thử (chỉ ghi nhật ký, KHÔNG xóa gì cả)" />
            <ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" Text="Sẵn sàng." />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ScanButton" Content="Quét" Width="110" Height="32" Click="ScanButton_Click" />
            <Button x:Name="CleanButton" Content="Dọn" Width="110" Height="32" Margin="10,0,0,0"
                    Click="CleanButton_Click" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="Dừng" Width="90" Height="32" Margin="10,0,0,0"
                    Click="CancelButton_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
