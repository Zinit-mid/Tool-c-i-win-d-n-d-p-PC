<UserControl x:Class="PCTool.Views.OfficeFixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <TextBlock Text="Sửa lỗi Word / Excel" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Foreground="Gray" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="Thử theo thứ tự từ nhẹ đến nặng: (1) mở ở chế độ an toàn để biết lỗi do add-in hay không, (2) đặt lại mẫu Normal.dotm của Word, (3) sửa Office bằng công cụ của Microsoft. Không bước nào xóa file tài liệu của bạn." />

        <GroupBox Header="1. Mở ở chế độ an toàn" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                           Text="Chế độ an toàn tắt các add-in và tùy biến. Nếu mở được ở chế độ này mà bình thường thì lỗi, nhiều khả năng do một add-in. Lưu ý: vì PCTool chạy quyền Administrator nên Word/Excel cũng mở bằng quyền đó." />
                <WrapPanel>
                    <Button x:Name="WordSafeButton" Content="Mở Word an toàn" Width="150" Height="34" Margin="0,0,10,0" Click="WordSafeButton_Click" />
                    <Button x:Name="ExcelSafeButton" Content="Mở Excel an toàn" Width="150" Height="34" Click="ExcelSafeButton_Click" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="2. Đặt lại mẫu Normal.dotm của Word" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                           Text="Đổi tên mẫu Normal.dotm (không xóa) để Word tự tạo mẫu mới. Hợp với lỗi Word đơ, mở chậm, định dạng lạ. Phải đóng Word trước." />
                <WrapPanel>
                    <Button x:Name="TemplateButton" Content="Đặt lại Normal.dotm" Width="170" Height="34" Margin="0,0,10,0" Click="TemplateButton_Click" />
                    <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi máy)" IsChecked="True" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="3. Sửa Office bằng công cụ của Microsoft" Padding="10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                           Text="Mở trang Ứng dụng của Windows. Tìm Microsoft 365 hoặc Office, chọn Sửa đổi hoặc Tùy chọn nâng cao, rồi bấm Sửa chữa (Repair). Sửa nhanh trước; nếu chưa hết lỗi mới sửa trực tuyến. Xong có thể cần khởi động lại máy." />
                <Button x:Name="RepairPageButton" Content="Mở trang sửa Office" Width="170" Height="34" HorizontalAlignment="Left" Click="RepairPageButton_Click" />
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ResultText" Margin="0,10,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
