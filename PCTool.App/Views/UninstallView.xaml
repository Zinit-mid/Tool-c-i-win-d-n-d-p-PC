<UserControl x:Class="PCTool.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Gỡ phần mềm cứng đầu" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Làm từng bước: (1) xem chương trình còn chạy không, (2) dừng nó nếu cần, (3) gỡ bằng trình gỡ riêng của chương trình (bạn xác nhận trong cửa sổ đó), (4) quét thư mục còn sót, (5) chuyển thư mục sót sang nơi riêng (không xóa). Danh sách gồm cả ứng dụng Microsoft Store (chỉ cần bấm Gỡ). PCTool không xóa Registry và không gỡ thành phần lõi của Windows/Microsoft." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="LoadButton" DockPanel.Dock="Right" Content="Tải danh sách" Width="120" Height="30" Margin="8,0,0,0" Click="LoadButton_Click" />
            <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Gõ tên chương trình để lọc" />
        </DockPanel>

        <DataGrid x:Name="ProgramsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="110" />
                <DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}" Width="100" />
                <DataGridTextColumn Header="Nhà phát hành" Binding="{Binding Publisher}" Width="160" />
                <DataGridTextColumn Header="Dung lượng" Binding="{Binding SizeText}" Width="90" />
                <DataGridTextColumn Header="Gỡ từ PCTool" Binding="{Binding Status}" Width="170" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="ResultBox" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="8" />

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" Text="Bấm &quot;Tải danh sách&quot; để bắt đầu." />
        </StackPanel>

        <WrapPanel Grid.Row="5" Margin="0,8,0,0">
            <Button x:Name="ActivityButton" Content="1. Xem đang chạy" Width="130" Height="32" Margin="0,0,8,6" Click="ActivityButton_Click" />
            <Button x:Name="StopButton" Content="2. Dừng" Width="90" Height="32" Margin="0,0,8,6" Click="StopButton_Click" IsEnabled="False" />
            <Button x:Name="UninstallButton" Content="3. Gỡ" Width="90" Height="32" Margin="0,0,8,6" Click="UninstallButton_Click" />
            <Button x:Name="LeftoverButton" Content="4. Quét tàn dư" Width="120" Height="32" Margin="0,0,8,6" Click="LeftoverButton_Click" />
            <Button x:Name="MoveButton" Content="5. Chuyển tàn dư" Width="130" Height="32" Margin="0,0,8,6" Click="MoveButton_Click" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="Dừng việc" Width="90" Height="32" Margin="0,0,8,6" Click="CancelButton_Click" IsEnabled="False" />
            <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi gì)" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,6" />
        </WrapPanel>
    </Grid>
</UserControl>
