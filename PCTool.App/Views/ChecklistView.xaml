<UserControl x:Class="PCTool.Views.ChecklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Việc cần làm sau khi cài Windows" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Tick từng việc khi làm xong; PCTool nhớ lại lần sau. Danh sách chỉ để theo dõi, tick không tự chạy gì." />
            <TextBlock x:Name="CountText" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel x:Name="ListPanel" />
            <Button Content="Bỏ tick tất cả" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Reset_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
