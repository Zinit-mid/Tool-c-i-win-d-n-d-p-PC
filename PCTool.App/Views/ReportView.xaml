<UserControl x:Class="PCTool.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Báo cáo &amp; bản quyền" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Gộp cấu hình máy, driver thiếu, bản quyền và chương trình khởi động thành một bản chữ để gửi cho người giúp. Phần bản quyền chỉ ĐỌC trạng thái Windows/Office, PCTool không kích hoạt gì và không hiện khóa sản phẩm." />
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="ReportButton" Content="Tạo báo cáo máy" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="Report_Click" />
                <Button x:Name="LicenseButton" Content="Chỉ xem bản quyền" Margin="0,0,8,4" Click="License_Click" />
                <Button Content="Sao chép" Margin="0,0,8,4" Click="Copy_Click" />
                <Button Content="Lưu ra file .txt..." Margin="0,0,8,4" Click="Save_Click" />
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar x:Name="Progress" Height="6" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" Text="Sẵn sàng." />
        </StackPanel>
        <TextBox x:Name="OutBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
    </DockPanel>
</UserControl>
