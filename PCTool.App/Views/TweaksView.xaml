<UserControl x:Class="PCTool.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Thiết lập Windows" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,10" TextWrapping="Wrap"
                       Text="Một số tinh chỉnh nhỏ, đổi lại được bằng nút ngược lại. PCTool CỐ Ý không có nút tắt UAC, SmartScreen, tường lửa, Defender hay cảnh báo bảo mật ở đây." />
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="ReadButton" Content="Đọc trạng thái hiện tại" Width="180" Height="30" Margin="0,0,10,0" Click="ReadButton_Click" />
                <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi gì)" IsChecked="True" VerticalAlignment="Center" />
            </WrapPanel>
            <StackPanel x:Name="Rows" />
            <GroupBox Header="Gói nguồn điện" Padding="10" Margin="0,8,0,8">
                <WrapPanel>
                    <Button Content="Cân bằng" Tag="Balanced" Width="120" Height="30" Margin="0,0,10,0" Click="Power_Click" />
                    <Button Content="Hiệu năng cao" Tag="HighPerformance" Width="120" Height="30" Margin="0,0,10,0" Click="Power_Click" />
                    <Button Content="Tiết kiệm pin" Tag="PowerSaver" Width="120" Height="30" Click="Power_Click" />
                </WrapPanel>
            </GroupBox>
            <ProgressBar x:Name="Progress" Height="8" IsIndeterminate="False" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap" Text="Sẵn sàng." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
