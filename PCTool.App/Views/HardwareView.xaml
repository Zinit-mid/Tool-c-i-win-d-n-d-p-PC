<UserControl x:Class="PCTool.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Thông số và sức khỏe phần cứng" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Bấm Đọc thông số để xem CPU, RAM, ổ cứng, card đồ họa, pin và tình trạng sức khỏe. Mục này chỉ đọc thông tin, không thay đổi gì trên máy (dùng được cả khi bật Chế độ an toàn)." />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Thông số máy" Margin="0,0,0,10">
            <TextBox x:Name="SpecsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="13" BorderThickness="0" />
        </GroupBox>

        <DataGrid x:Name="FindingsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mức" Binding="{Binding SeverityText}" Width="110" />
                <DataGridTextColumn Header="Vấn đề" Binding="{Binding Title}" Width="220" />
                <DataGridTextColumn Header="Nguyên nhân / lời khuyên" Binding="{Binding Cause}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" Text="Sẵn sàng." />
        </StackPanel>

        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="ReadButton" Content="Đọc thông số" Width="130" Height="40" Margin="0,0,10,6"
                    Click="ReadButton_Click" />
            <Button x:Name="CopyButton" Content="Sao chép báo cáo" Width="140" Height="40" Margin="0,0,10,6"
                    Click="CopyButton_Click" IsEnabled="False" />
        </WrapPanel>
    </Grid>
</UserControl>
