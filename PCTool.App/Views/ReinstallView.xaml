<UserControl x:Class="PCTool.Views.ReinstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Cài lại Windows: kiểm tra USB và file ISO" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Mới là các bước đầu của tính năng Cài lại Windows, chỉ KIỂM TRA: (1) liệt kê ổ USB và cho biết ổ nào đủ điều kiện, (2) kiểm tra file ISO Windows bạn đã tải từ Microsoft. Chưa ghi, chưa xóa, chưa format gì. Kiểm tra ISO có gắn ISO tạm ở chế độ chỉ đọc rồi gỡ ra. Chỉ ổ gắn qua USB mới hiện; ổ Windows, ổ chứa ISO và ổ chứa thư mục sao lưu luôn bị loại." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Foreground="Gray" Text="Tùy chọn: nếu đã có file ISO hoặc thư mục sao lưu, nhập đường dẫn để app loại ổ chứa chúng (chỉ lấy ký tự ổ, ví dụ E:\iso\Win11.iso)." TextWrapping="Wrap" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="File ISO:" VerticalAlignment="Center" />
                <TextBox x:Name="IsoBox" Grid.Row="0" Grid.Column="1" Margin="0,2" />
                <WrapPanel Grid.Row="0" Grid.Column="2" Margin="6,0,0,0">
                    <Button x:Name="BrowseIsoButton" Content="Chọn file..." Width="90" Margin="0,2,6,2" Click="BrowseIsoButton_Click" />
                    <Button x:Name="CheckIsoButton" Content="Kiểm tra ISO" Width="100" Margin="0,2" Click="CheckIsoButton_Click" />
                </WrapPanel>
                <TextBlock Grid.Row="2" Text="Tải ISO:" VerticalAlignment="Center" />
                <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2">
                    <Button Content="Mở trang tải Windows 11" Width="170" Margin="0,0,8,0" Tag="11" Click="DownloadPage_Click" />
                    <Button Content="Mở trang tải Windows 10" Width="170" Tag="10" Click="DownloadPage_Click" />
                    <TextBlock Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" Text="(chỉ mở trình duyệt, bạn tự tải)" />
                </WrapPanel>
                <TextBlock Grid.Row="1" Text="Thư mục sao lưu:" VerticalAlignment="Center" />
                <TextBox x:Name="BackupBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="ScanButton" Content="Quét ổ USB" Width="130" Height="34" Margin="0,0,10,0" Click="ScanButton_Click" />
                <Button x:Name="CopyButton" Content="Sao chép kết quả" Width="140" Height="34" IsEnabled="False" Click="CopyButton_Click" />
            </WrapPanel>

            <GroupBox Header="Ghi USB cài Windows (XÓA SẠCH ổ USB được chọn)" Padding="10" Margin="0,12,0,0" Foreground="#B00020">
                <StackPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Cần làm trước: (1) bấm Quét ổ USB, (2) nhập đường dẫn ISO rồi bấm Kiểm tra ISO và ISO phải dùng được. Ghi USB sẽ xóa toàn bộ dữ liệu trên ổ USB bạn chọn, tạo USB khởi động UEFI (FAT32 cài đặt + NTFS dữ liệu). Chỉ tác động lên đúng ổ USB đã chọn; không đụng ổ Windows hay ổ khác. Mặc định chỉ CHẠY THỬ." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Chọn ổ USB:" VerticalAlignment="Center" Foreground="Black" />
                        <ComboBox x:Name="UsbCombo" Grid.Row="0" Grid.Column="1" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="Gõ lại mã:" VerticalAlignment="Center" Foreground="Black" />
                        <TextBox x:Name="ConfirmBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Width="200" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6"
                               Text="Mã xác nhận: số ổ, dấu gạch ngang, 4 ký tự cuối của serial (đã hiện ở phần Kết quả sau khi quét, ví dụ 3-1234). Phải tự gõ, app không điền sẵn." />
                    <CheckBox x:Name="AckBox" Foreground="Black" Margin="0,0,0,4" TextBlock.FontWeight="SemiBold"
                              Content="Tôi hiểu: TOÀN BỘ dữ liệu trên ổ USB đã chọn sẽ bị xóa vĩnh viễn, không khôi phục được." />
                    <CheckBox x:Name="AnswerBox" Foreground="Black" Margin="0,4,0,2"
                              Content="Tạo kèm file autounattend.xml tối thiểu (chọn sẵn ngôn ngữ của ISO, chấp nhận điều khoản, bỏ qua màn nhập key; VẪN để bạn tự chọn ổ cài)" />
                    <CheckBox x:Name="BypassBox" Foreground="#B00020" Margin="16,0,0,2"
                              Content="Windows 11 máy cũ: bỏ qua kiểm tra TPM/CPU/RAM (KHÔNG chính thức, Microsoft có thể không hỗ trợ/cập nhật máy này)" />
                    <WrapPanel>
                        <Button x:Name="WriteButton" Content="Ghi USB" Width="130" Height="34" Margin="0,4,10,0" Click="WriteButton_Click" />
                        <CheckBox x:Name="DryRunBox" Content="Chạy thử (không thay đổi gì)" IsChecked="True" VerticalAlignment="Center" Foreground="Black" Margin="0,4,0,0" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Kết quả">
            <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13" BorderThickness="0" />
        </GroupBox>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
