<Window x:Class="PCTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCTool.Views"
        Title="PCTool - Cài Win &amp; Dọn dẹp PC" Height="640" Width="980"
        MinHeight="480" MinWidth="760" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border x:Name="SafeBanner" Grid.Row="0" Background="#FFFFF4CE" Padding="10,6" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                       Text="Chế độ an toàn đang BẬT: mọi thao tác thay đổi máy đều bị khóa. Bạn vẫn quét và xem thông số được." />
        </Border>

        <DockPanel Grid.Row="1" Margin="10,6,10,0" LastChildFill="True">
            <CheckBox x:Name="SafeModeBox" DockPanel.Dock="Left" Content="Chế độ an toàn (máy công ty: chỉ xem, không sửa)"
                      VerticalAlignment="Center" Margin="0,0,16,0" Click="SafeModeBox_Click" />
            <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="Kiểm tra cập nhật" Padding="10,3"
                    Click="CheckUpdateButton_Click" />
            <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="Cập nhật ngay" Padding="10,3"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="InstallUpdateButton_Click" />
            <ProgressBar x:Name="UpdateProgress" DockPanel.Dock="Right" Width="120" Height="8" Margin="0,0,8,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="UpdateText" Foreground="Gray" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="2" TabStripPlacement="Left" Margin="6">
            <TabItem Header="Tổng quan (quét lỗi)" Padding="12,8">
                <views:OverviewView />
            </TabItem>
            <TabItem Header="Dọn dẹp rác" Padding="12,8">
                <views:CleanupView />
            </TabItem>
            <TabItem Header="Cài nhanh ứng dụng" Padding="12,8">
                <views:AppInstallerView />
            </TabItem>
            <TabItem Header="Thông số phần cứng" Padding="12,8">
                <views:HardwareView />
            </TabItem>
            <TabItem Header="Sao lưu Driver / Wi-Fi" Padding="12,8">
                <views:BackupView />
            </TabItem>
            <TabItem Header="Dọn thư mục thông minh" Padding="12,8">
                <views:FolderCleanupView />
            </TabItem>
            <TabItem Header="Sao lưu / Khôi phục app" Padding="12,8">
                <views:BackupRestoreView />
            </TabItem>
            <TabItem Header="Cài lại Win trực tiếp" Padding="12,8">
                <views:DirectReinstallView />
            </TabItem>
            <TabItem Header="Khôi phục sau cài Win" Padding="12,8">
                <views:RestoreView />
            </TabItem>
            <TabItem Header="Gỡ phần mềm cứng đầu" Padding="12,8">
                <views:UninstallView />
            </TabItem>
            <TabItem Header="Tiện ích khác" Padding="12,8">
                <views:ToolsView />
            </TabItem>
            <TabItem Header="Chẩn đoán máy in" Padding="12,8">
                <views:PrinterView />
            </TabItem>
            <TabItem Header="Sửa lỗi Word / Excel" Padding="12,8">
                <views:OfficeFixView />
            </TabItem>
            <TabItem Header="Windows Update" Padding="12,8">
                <views:WindowsUpdateView />
            </TabItem>
            <TabItem Header="Windows Defender" Padding="12,8">
                <views:DefenderView />
            </TabItem>
            <TabItem Header="Cài lại Windows" Padding="12,8">
                <views:ReinstallView />
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="3" Header="Nhật ký thao tác" Margin="6,0,6,6">
            <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
